# SilkPortal SSO (https://auth.qaqan.cn) — register an app at https://auth.qaqan.cn/apps
SILKPORTAL_CLIENT_ID=
SILKPORTAL_CLIENT_SECRET=
AUTH_SECRET=                # generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:7127
# For Vercel production, set NEXTAUTH_URL to your reader app origin.

# Vercel Postgres (connection string from your Vercel project storage tab)
POSTGRES_URL=

# Vercel Blob (read+write token from your Vercel project storage tab)
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_WEBSITE_URL=http://localhost:7117
